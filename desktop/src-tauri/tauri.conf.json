{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NICS AI Trader",
  "version": "1.0.0",
  "identifier": "com.aibyteconsult.nicstrader",
  "build": {
    "frontendDist": "../offline"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "AI Byte Consult Ltd",
    "copyright": "© AI Byte Consult Ltd",
    "category": "Finance",
    "shortDescription": "NICS AI Trader",
    "longDescription": "NICS AI Trader: trading signals, verified track record and your personal account.",
    "homepage": "https://aibyteconsult.com/trading",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
