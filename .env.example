# Copy this file to .env and fill in real values. .env is gitignored.
#
# These are Vite build-time variables: whatever you put here is compiled
# into the public JS bundle and is readable by anyone who opens the site.
# Only ever put values here that are safe to be public -- the Supabase
# publishable (anon) key is designed for that and is protected by RLS.
# Never put a service-role key, a Telegram bot token, or any server-side
# secret in this file.

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
